#!/usr/bin/env bash
# marinara-sync: rebase the Marinara fork onto upstream staging, validate, push, and deploy.
# Runs daily at 03:00 from marinara-sync.timer.
#
#   marinara-sync              full run
#   marinara-sync --dry-run    everything up to the push; no push, no Claude session
#   marinara-sync --deploy     deploy only: build and swap in GitHub's luma/staging if beebox runs an older build
#   marinara-sync --test-handoff PROMPT_FILE
#                              skip the sync; start the Claude session with PROMPT_FILE
#                              in place of the real prompt (to test the hand-off)
#
# A clean run (no conflict, check passes) pushes on its own, deploys, and stays silent.
# Deploy builds the image while the old server runs (marinara build fork), swaps it in
# (marinara up fork), and checks /api/health. An unhealthy build is rolled back to the
# previous image. Storage-format changes deploy like any other (Eli has daily backups).
# After a push, and at the start of --deploy, it reinstalls the host tooling from
# origin/patch/fork-tooling (tools/beebox/install.sh), so the live copies track the repo.
# Deploy only acts while the channel is "fork"; if Eli switched to "main", it leaves it.
# Anything else (conflict, empty patch, audit stop, failed check, low memory)
# starts an interactive Claude session with Remote Control in tmux, which
# resolves it, validates, pushes, and notifies Eli's phone only if it fails.
#
# Work happens only in its own clone, so it never touches a checkout someone is
# using. Validation runs through tools/fork/in-node.sh (6 GiB, CPUs 1-3, one
# check lane at a time), and marinara-guard watches it like any heavy job.
set -euo pipefail

# Host settings: ~/.config/marinara/beebox.env (see tools/beebox/beebox.env.example).
conf=${MARINARA_BEEBOX_ENV:-$HOME/.config/marinara/beebox.env}
if [ -r "$conf" ]; then . "$conf"; fi
REPO=${MARINARA_SYNC_REPO:-$HOME/code/luma/Marinara-Engine-sync}
STATE="$HOME/.local/state/marinara-sync"
PROMPT="$HOME/.config/marinara-sync/claude-prompt.md"
CLAUDE=${MARINARA_CLAUDE:-$HOME/.local/bin/claude}
# pnpm check peaks at about 3.1 GiB; keep the guard's 2 GiB reserve
MIN_AVAILABLE_KIB=$((${MARINARA_SYNC_MIN_AVAILABLE_GIB:-6} * 1024 * 1024))
# the image build runs in the buildx builder `capped` (5 GiB), so it needs less than pnpm check
DEPLOY_MIN_AVAILABLE_KIB=$((${MARINARA_SYNC_DEPLOY_MIN_AVAILABLE_MIB:-5120} * 1024))
MEMORY_WAIT_MINUTES=${MARINARA_SYNC_MEMORY_WAIT_MINUTES:-30}
KEEP_LOGS=${MARINARA_SYNC_KEEP_LOGS:-14}
MARINARA="$HOME/.local/bin/marinara"
DEPLOY_DIR=${MARINARA_DEPLOY_DIR:-$HOME/marinara}
CHANNEL="$DEPLOY_DIR/channel"
PORT=${MARINARA_PORT:-7860}
KEEP_ROLLBACK_IMAGES=${MARINARA_KEEP_ROLLBACK_IMAGES:-3}
TOOLING_REF=origin/patch/fork-tooling

dry_run=false
deploy_only=false
test_handoff=""
case "${1:-}" in
  --dry-run) dry_run=true ;;
  --deploy) deploy_only=true ;;
  --test-handoff) test_handoff=${2:?--test-handoff needs a prompt file}; PROMPT=$test_handoff ;;
esac

mkdir -p "$STATE/runs"
stamp=$(date +%F_%H%M)
log="$STATE/runs/$stamp.log"
tools=$(mktemp -d "${TMPDIR:-/tmp}/marinara-sync.XXXX")
trap 'rm -rf "$tools"' EXIT

say() { printf '%s %s\n' "$(date +%T)" "$*" | tee -a "$log" >&2; }

record() { # record <result> <detail>
  printf '{"ts":"%s","result":"%s","detail":"%s","log":"%s","dry_run":%s}\n' \
    "$(date -Iseconds)" "$1" "${2//\"/\'}" "$log" "$dry_run" >"$STATE/last.json"
}

available_kib() { awk '/^MemAvailable:/ {print $2}' /proc/meminfo; }

memory_holders() { # the six biggest processes and every container, by resident memory
  { ps -eo rss=,args= --sort=-rss | head -n 6 | awk '{
    mib = int($1 / 1024); cmd = $2; sub(/.*\//, "", cmd); $1 = $2 = ""; rest = substr($0, 3)
    printf "%s%d MiB %s", (NR > 1 ? "; " : ""), mib, substr(cmd " " rest, 1, 70)
  }'; } 2>/dev/null || true
  printf ' | containers: %s' "$(docker stats --no-stream --format '{{.Name}} {{.MemUsage}}' 2>/dev/null | cut -d/ -f1 | paste -sd, -)"
}

wait_for_memory() { # wait_for_memory [min KiB]
  local need=${1:-$MIN_AVAILABLE_KIB} waited=0
  while [ "$(available_kib)" -lt "$need" ]; do
    [ "$waited" -ge "$MEMORY_WAIT_MINUTES" ] && return 1
    say "waiting for memory: $(($(available_kib) / 1024)) MiB available, need $((need / 1024))"
    [ $((waited % 10)) -eq 0 ] && say "memory holders: $(memory_holders)"
    sleep 60
    waited=$((waited + 1))
  done
}

hand_to_claude() { # hand_to_claude <reason>
  local reason=$1
  record "handed-to-claude" "$reason"
  if $dry_run; then
    say "dry run: would start a Claude session for: $reason"
    return 0
  fi
  local session="marinara-sync-$(date +%m%d)"
  local run_prompt="$STATE/runs/$stamp.prompt.md"
  {
    cat "$PROMPT"
    printf '\n## This run\n\n- Started: %s\n- Clone: %s\n- Why you were started: %s\n- Full log: %s\n\nLast 60 lines of the log:\n\n```\n' \
      "$(date -Iseconds)" "$REPO" "$reason" "$log"
    tail -n 60 "$log"
    printf '```\n'
  } >"$run_prompt"
  # Its own scope, so the session outlives this job when systemd cleans up the service.
  # 9>&- : the tmux server must not inherit the lock fd, or it holds the lock for as long as it lives.
  systemd-run --user --scope --quiet --collect --unit="$session-$(date +%H%M%S)" 9>&- -- \
    tmux new-session -d -s "$session" -c "$REPO" \
      "$CLAUDE --remote-control 'marinara sync $(date +%m-%d)' --permission-mode auto \"\$(cat '$run_prompt')\""
  say "started Claude session in tmux: $session"
}

install_tooling() { # copy tools/beebox from the pushed patch/fork-tooling to the live paths
  local out
  if out=$(git -C "$REPO" show "$TOOLING_REF:tools/beebox/install.sh" | bash -s -- --ref "$TOOLING_REF" --repo "$REPO" 2>&1); then
    say "tooling: $(echo "$out" | tr '\n' ' ')"
  else
    say "tooling: install from $TOOLING_REF failed (keeping the live copies): $(echo "$out" | tail -n 3 | tr '\n' ' ')"
  fi
}

healthy() { # up to 3 minutes for /api/health to answer ok
  local i
  for i in $(seq 36); do
    sleep 5
    curl -sf --max-time 5 "http://127.0.0.1:$PORT/api/health" | grep -q '"status":"ok"' && return 0
  done
  return 1
}

deploy() { # deploy GitHub's luma/staging if beebox runs something older; returns 0 when nothing more is needed
  cd "$REPO"
  if ! git fetch -q gh luma/staging; then
    hand_to_claude "deploy: could not fetch luma/staging from GitHub"
    return 1
  fi
  local target cur_ch="" cur_sha=""
  target=$(git rev-parse FETCH_HEAD)
  read -r cur_ch cur_sha <"$CHANNEL" 2>/dev/null || true
  if [ "$cur_ch" != fork ]; then
    say "deploy: channel is '${cur_ch:-none}', not fork; leaving it alone"
    return 0
  fi
  if [ -n "$cur_sha" ] && [[ $target == "$cur_sha"* ]]; then
    say "deploy: beebox already runs $cur_sha"
    return 0
  fi
  if $dry_run; then
    say "dry run: would deploy ${target:0:9} over ${cur_sha:-nothing}"
    return 0
  fi
  if ! wait_for_memory "$DEPLOY_MIN_AVAILABLE_KIB"; then
    hand_to_claude "deploy: memory stayed below $((DEPLOY_MIN_AVAILABLE_KIB / 1024)) MiB; the image was not built"
    return 1
  fi
  say "deploy: building ${target:0:9}"
  if ! nice "$MARINARA" build fork >>"$log" 2>&1; then
    hand_to_claude "deploy: image build failed; the old server is still running"
    return 1
  fi
  say "deploy: swapping it in"
  if ! "$MARINARA" up fork >>"$log" 2>&1; then
    hand_to_claude "deploy: swap failed; see the log"
    return 1
  fi
  if ! healthy; then
    say "deploy: new build unhealthy; rolling back to $cur_sha"
    if [ -n "$cur_sha" ] && docker image inspect "marinara:fork-$cur_sha" >/dev/null 2>&1; then
      MARINARA_IMAGE="marinara:fork-$cur_sha" docker compose -f "$DEPLOY_DIR/compose.yml" up -d >>"$log" 2>&1 || true
      echo "fork $cur_sha" >"$CHANNEL"
      if healthy; then
        hand_to_claude "deploy: ${target:0:9} came up unhealthy; rolled back to $cur_sha, which is healthy"
      else
        hand_to_claude "deploy: ${target:0:9} came up unhealthy and the rollback to $cur_sha is unhealthy too; Marinara may be down"
      fi
    else
      hand_to_claude "deploy: ${target:0:9} came up unhealthy and there is no rollback image; Marinara may be down"
    fi
    return 1
  fi
  say "deploy: running ${target:0:9}"
  docker images marinara --format '{{.Tag}}' | grep '^fork-' | tail -n +$((KEEP_ROLLBACK_IMAGES + 1)) |
    while read -r tag; do docker rmi "marinara:$tag" >/dev/null 2>&1 && say "deploy: pruned marinara:$tag"; done
  return 0
}

main() {
  exec 9>"$STATE/lock"
  if ! flock -n 9; then
    say "another marinara-sync is running; exiting"
    return 0
  fi
  say "start (dry_run=$dry_run)"

  if [ -n "$test_handoff" ]; then
    hand_to_claude "test of the hand-off"
    return 0
  fi

  if $deploy_only; then
    install_tooling
    deploy && record "deployed" "beebox runs $(cut -d' ' -f2 "$CHANNEL" 2>/dev/null)"
    return 0
  fi

  # A Claude session from an earlier run owns the clone until it records "resolved" in last.json.
  local open_sessions
  open_sessions=$(tmux ls -F '#{session_name}' 2>/dev/null | grep '^marinara-sync-' || true)
  if [ -n "$open_sessions" ]; then
    if grep -q '"result":"handed-to-claude"' "$STATE/last.json" 2>/dev/null; then
      say "an earlier Claude session ($open_sessions) has not finished; leaving the clone to it"
      return 0
    fi
    $dry_run || for s in $open_sessions; do tmux kill-session -t "$s"; say "closed finished Claude session $s"; done
  fi

  if ! wait_for_memory; then
    say "memory stayed below $((MIN_AVAILABLE_KIB / 1024)) MiB for $MEMORY_WAIT_MINUTES minutes"
    hand_to_claude "low memory: the sync never started"
    return 0
  fi

  cd "$REPO"
  if [ -n "$(git status --porcelain)" ] || [ -e "$(git rev-parse --git-path rebase-merge)" ] || [ -e "$(git rev-parse --git-path rebase-apply)" ]; then
    hand_to_claude "the sync clone was not clean (an unfinished rebase or changes from an earlier run)"
    return 0
  fi

  nice git fetch -q origin --prune
  git show origin/patch/fork-tooling:tools/fork/apply-patches.mjs >"$tools/apply-patches.mjs"
  git show origin/patch/fork-tooling:tools/fork/patches.list >"$tools/patches.list"

  say "rebasing onto upstream/staging"
  if ! FORK_PATCH_LIST="$tools/patches.list" nice node "$tools/apply-patches.mjs" >>"$log" 2>&1; then
    hand_to_claude "apply-patches stopped (conflict, freshness check, or audit)"
    return 0
  fi
  if grep -q "is now EMPTY" "$log"; then
    hand_to_claude "a patch rebased to empty (upstream may have adopted it); retire it"
    return 0
  fi

  if git diff --quiet origin/luma/staging luma/staging -- . ':!fork-base.json'; then
    say "nothing changed since the last push"
    record "unchanged" "no new upstream commits and no patch changes"
    deploy && record "unchanged" "no new commits; beebox runs $(cut -d' ' -f2 "$CHANNEL" 2>/dev/null)"
    return 0
  fi

  say "validating: pnpm install, pnpm check (capped, one lane at a time)"
  if ! nice tools/fork/in-node.sh pnpm install --frozen-lockfile >>"$log" 2>&1; then
    hand_to_claude "pnpm install failed"
    return 0
  fi
  if ! nice tools/fork/in-node.sh pnpm check >>"$log" 2>&1; then
    hand_to_claude "pnpm check failed (or the guard killed it; see ~/.local/state/marinara-guard/kills.jsonl)"
    return 0
  fi

  if $dry_run; then
    say "dry run: validated; not pushing"
    record "validated-dry-run" "$(git rev-parse --short luma/staging)"
    return 0
  fi
  say "pushing"
  if ! tools/fork/push-sync.sh >>"$log" 2>&1; then
    hand_to_claude "push-sync.sh refused or failed"
    return 0
  fi
  say "done: pushed $(git rev-parse --short luma/staging)"
  install_tooling
  record "pushed" "$(git rev-parse --short luma/staging) on $(git rev-parse --short staging)"
  deploy && record "pushed-and-deployed" "$(git -C "$REPO" rev-parse --short luma/staging) on $(git -C "$REPO" rev-parse --short staging); beebox runs $(cut -d' ' -f2 "$CHANNEL" 2>/dev/null)"
}

main
ls -1t "$STATE/runs"/*.log 2>/dev/null | tail -n +$((KEEP_LOGS + 1)) | xargs -r rm -f --
