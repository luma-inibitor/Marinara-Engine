#!/bin/bash
# marinara — switch the Beebox's Marinara between the fork and upstream staging.
# Mirrors the Termux switcher: update the clone, build its image, restart on the shared data.
# `build` only builds (no downtime); `up` swaps a built image in; `fork`/`main` do both.
# Host settings: ~/.config/marinara/beebox.env (see tools/beebox/beebox.env.example).
set -euo pipefail
conf=${MARINARA_BEEBOX_ENV:-$HOME/.config/marinara/beebox.env}
if [ -r "$conf" ]; then . "$conf"; fi
: "${MARINARA_DEPLOY_DIR:=$HOME/marinara}"
: "${MARINARA_FORK_DIR:=$HOME/Marinara-fork}"
: "${MARINARA_FORK_URL:=https://github.com/luma-inibitor/Marinara-Engine}"
: "${MARINARA_FORK_BRANCH:=luma/staging}"
: "${MARINARA_MAIN_DIR:=$HOME/Marinara-main}"
: "${MARINARA_MAIN_URL:=https://github.com/Pasta-Devs/Marinara-Engine}"
: "${MARINARA_MAIN_BRANCH:=staging}"
: "${MARINARA_HOST:=beebox}"
: "${MARINARA_PORT:=7860}"
COMPOSE=(docker compose -f "$MARINARA_DEPLOY_DIR/compose.yml")
STATE="$MARINARA_DEPLOY_DIR/channel"

update_clone() { # dir remote branch
  git -C "$1" fetch --quiet "$2" "$3" || { echo "offline? using local checkout"; return 0; }
  git -C "$1" merge --ff-only --quiet FETCH_HEAD 2>/dev/null || git -C "$1" reset --hard --quiet FETCH_HEAD
}


channel() { # ch -> sets dir remote branch
  case "$1" in
    fork|f) ch=fork; dir=$MARINARA_FORK_DIR; remote=$MARINARA_FORK_URL; branch=$MARINARA_FORK_BRANCH ;;
    main|m) ch=main; dir=$MARINARA_MAIN_DIR; remote=$MARINARA_MAIN_URL; branch=$MARINARA_MAIN_BRANCH ;;
    *) echo "unknown channel: $1 (fork or main)" >&2; exit 1 ;;
  esac
}

build() { # ch — build marinara:<ch>-next while the old server keeps running
  local ch dir remote branch sha
  channel "$1"
  echo "▶ building $ch ($branch)"
  update_clone "$dir" "$remote" "$branch"
  sha=$(git -C "$dir" rev-parse --short HEAD)
  docker build -q --label "marinara.sha=$sha" -t "marinara:$ch-next" "$dir"
  echo "✓ built marinara:$ch-next at $sha; swap it in with: marinara up $ch"
}

up() { # ch — swap the built marinara:<ch>-next in
  local ch dir remote branch sha
  channel "$1"
  sha=$(docker image inspect -f '{{index .Config.Labels "marinara.sha"}}' "marinara:$ch-next" 2>/dev/null || true)
  [ -n "$sha" ] || { echo "no built image marinara:$ch-next; run: marinara build $ch" >&2; exit 1; }
  # Keep the outgoing image for rollback as marinara:<channel>-<old sha>.
  local prev_ch prev_sha
  read -r prev_ch prev_sha < "$STATE" 2>/dev/null || true
  if [ "${prev_ch:-}" = "$ch" ] && [ -n "${prev_sha:-}" ] && docker image inspect "marinara:$ch" >/dev/null 2>&1; then
    docker tag "marinara:$ch" "marinara:$ch-$prev_sha"
  fi
  docker tag "marinara:$ch-next" "marinara:$ch"
  docker rmi "marinara:$ch-next" >/dev/null
  MARINARA_IMAGE="marinara:$ch" "${COMPOSE[@]}" up -d
  echo "$ch $sha" > "$STATE"
  echo "✓ running $ch at http://$MARINARA_HOST:$MARINARA_PORT"
}

case "${1:-status}" in
  fork|f|main|m) build "$1" && up "$1" ;;
  build)  build "${2:-fork}" ;;
  up)     up "${2:-fork}" ;;
  stop)   "${COMPOSE[@]}" down ;;
  logs)   docker logs -f --tail 100 marinara ;;
  status)
    echo "channel: $(cat "$STATE" 2>/dev/null || echo none)"; docker ps --filter name=marinara --format "{{.Status}}"
    for c in fork main; do
      s=$(docker image inspect -f '{{index .Config.Labels "marinara.sha"}}' "marinara:$c-next" 2>/dev/null) && echo "built, not running: $c at $s (marinara up $c)"
    done; true ;;
  *)      echo "usage: marinara [fork|main|build [fork|main]|up [fork|main]|stop|logs|status]"; exit 1 ;;
esac
