# beebox host settings for tools/beebox (marinara, marinara-sync, marinara-rebuild, marinara-guard).
# Live copy: ~/.config/marinara/beebox.env. install.sh writes it from this example only when it
# is missing and never overwrites it. Every value below is the script's built-in default, so
# delete any line you don't need to change. No secrets here: those stay in ~/marinara/secrets.env.
#
# The bash scripts source this file. marinara-guard reads it as a systemd EnvironmentFile,
# which does not expand $HOME, so the guard's settings are plain numbers.

# Deploy (marinara, marinara-sync --deploy)
MARINARA_DEPLOY_DIR="$HOME/marinara"          # compose.yml, channel, secrets.env
MARINARA_FORK_DIR="$HOME/Marinara-fork"
MARINARA_FORK_URL="https://github.com/luma-inibitor/Marinara-Engine"
MARINARA_FORK_BRANCH="luma/staging"
MARINARA_MAIN_DIR="$HOME/Marinara-main"
MARINARA_MAIN_URL="https://github.com/Pasta-Devs/Marinara-Engine"
MARINARA_MAIN_BRANCH="staging"
MARINARA_HOST="beebox"                        # only for the "running at" message
MARINARA_PORT=7860
MARINARA_KEEP_ROLLBACK_IMAGES=3

# Nightly sync (marinara-sync) and rebuilds (marinara-rebuild)
MARINARA_SYNC_REPO="$HOME/code/luma/Marinara-Engine-sync"
MARINARA_DEV_REPO="$HOME/code/luma/Marinara-Engine"
MARINARA_CLAUDE="$HOME/.local/bin/claude"
MARINARA_SYNC_MIN_AVAILABLE_GIB=6             # whole GiB; pnpm check peaks at ~3.1 GiB
MARINARA_SYNC_MEMORY_WAIT_MINUTES=30
MARINARA_SYNC_KEEP_LOGS=14

# Memory guard (marinara-guard; restart it after a change: systemctl --user restart marinara-guard)
MARINARA_GUARD_MIN_AVAILABLE_GIB=2.0
MARINARA_GUARD_PANIC_AVAILABLE_GIB=1.0
MARINARA_GUARD_MAX_PSI_FULL=10.0
MARINARA_GUARD_BACKOFF_S=10.0
MARINARA_GUARD_INTERVAL_S=1.0
MARINARA_GUARD_DRY_RUN=0
