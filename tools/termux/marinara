#!/data/data/com.termux/files/usr/bin/bash
# marinara — switch between the custom fork and stock mainline of Marinara Engine
# on Android/Termux, then launch it.
#
# This script deliberately lives OUTSIDE the repositories (installed to
# ~/.local/bin) so that switching channels never rewrites the switcher itself.
# It owns the git update for each clone and then hands off to that checkout's
# own start-termux.sh with --skip-update (the stock launcher only understands
# main/staging, so we do the update ourselves and skip its branch-unaware one).
#
# Canonical source: tools/termux/marinara on the fork's luma/main branch.
# Reinstall after editing with tools/termux/install.sh.
set -uo pipefail

# ── Config (override via environment if your layout differs) ──
FORK_DIR="${MARINARA_FORK_DIR:-$HOME/Marinara-fork}"
MAIN_DIR="${MARINARA_MAIN_DIR:-$HOME/Marinara-main}"
FORK_REMOTE="${MARINARA_FORK_REMOTE:-https://github.com/luma-inibitor/Marinara-Engine}"
FORK_BRANCH="${MARINARA_FORK_BRANCH:-luma/main}"
MAIN_REMOTE="${MARINARA_MAIN_REMOTE:-https://github.com/Pasta-Devs/Marinara-Engine}"
MAIN_BRANCH="${MARINARA_MAIN_BRANCH:-main}"
DEV_ROOT="${MARINARA_DEV_ROOT:-$HOME/marinara-dev}"
DEV_PORT="${MARINARA_DEV_PORT:-7870}"
LAUNCHER="start-termux.sh"

c_bold=$'\e[1m'; c_grn=$'\e[32m'; c_ylw=$'\e[33m'; c_red=$'\e[31m'; c_dim=$'\e[2m'; c_rst=$'\e[0m'
say()  { printf '%s\n' "$*"; }
warn() { printf '%s[warn]%s %s\n' "$c_ylw" "$c_rst" "$*" >&2; }
die()  { printf '%s[error]%s %s\n' "$c_red" "$c_rst" "$*" >&2; exit 1; }

update_clone() {
  # Fast-forward a deploy clone to its remote branch tip. No-op when already
  # current (so it never triggers a needless rebuild). On a real update, discard
  # the launcher's tracked .npmrc tweak first so the fast-forward is clean; the
  # launcher re-adds it and rebuilds while applying the update anyway.
  local dir="$1" remote="$2" branch="$3"
  [ -d "$dir/.git" ] || die "No clone at $dir — run the installer first."
  say "${c_dim}Checking $branch for updates…${c_rst}"
  if ! git -C "$dir" fetch --quiet "$remote" "$branch" 2>/dev/null; then
    warn "Couldn't reach $remote (offline?). Launching the current local version."
    return 0
  fi
  local head target
  head="$(git -C "$dir" rev-parse HEAD 2>/dev/null || true)"
  target="$(git -C "$dir" rev-parse FETCH_HEAD 2>/dev/null || true)"
  if [ -z "$target" ] || [ "$head" = "$target" ]; then
    say "${c_grn}Already up to date.${c_rst}"
    return 0
  fi
  say "Updating $(basename "$dir") → ${target:0:9}…"
  git -C "$dir" checkout -- .npmrc 2>/dev/null || true
  if ! git -C "$dir" merge --ff-only "$target" --quiet 2>/dev/null; then
    git -C "$dir" reset --hard "$target" --quiet || die "Update failed in $dir"
  fi
}

launch() {
  local channel="$1" dir remote branch
  case "$channel" in
    fork) dir="$FORK_DIR"; remote="$FORK_REMOTE"; branch="$FORK_BRANCH" ;;
    main) dir="$MAIN_DIR"; remote="$MAIN_REMOTE"; branch="$MAIN_BRANCH" ;;
    *) die "Unknown channel: $channel" ;;
  esac
  [ -d "$dir" ]           || die "$dir not found — run the installer first."
  [ -f "$dir/$LAUNCHER" ] || die "$dir has no $LAUNCHER (is this a Marinara checkout?)."

  clear 2>/dev/null || true
  if [ "$channel" = fork ]; then
    say "${c_bold}${c_grn}▶ Marinara — CUSTOM FORK${c_rst}  ${c_dim}($branch)${c_rst}"
  else
    say "${c_bold}▶ Marinara — MAINLINE (stock)${c_rst}  ${c_dim}($branch)${c_rst}"
  fi
  say "${c_dim}$dir${c_rst}"
  update_clone "$dir" "$remote" "$branch"
  cd "$dir" || die "cd $dir failed"
  exec "./$LAUNCHER" --skip-update
}

dev() {
  # Throwaway checkout of an arbitrary repo/branch with its OWN isolated data.
  # Never touches the shared ~/marinara-data or the fork/main clones. The user
  # owns cleanup: rm -rf the printed directory when done.
  local slug="$1" branch="$2"
  [ -n "$slug" ] && [ -n "$branch" ] || die "Usage: marinara dev <owner/repo> <branch>"
  local url="$slug"
  case "$slug" in *://*|git@*) : ;; *) url="https://github.com/$slug" ;; esac
  local id dest
  id="$(printf '%s' "$slug-$branch" | tr '[:upper:]' '[:lower:]' | sed -E 's#[^a-z0-9]+#-#g; s#(^-+|-+$)##g')"
  dest="$DEV_ROOT/$id"
  mkdir -p "$DEV_ROOT"

  clear 2>/dev/null || true
  say "${c_bold}${c_ylw}▶ Marinara — DEV (throwaway)${c_rst}  ${c_dim}$slug @ $branch${c_rst}"
  say "${c_dim}$dest  ·  port $DEV_PORT  ·  isolated data (no sharing with fork/main)${c_rst}"

  if [ -d "$dest/.git" ]; then
    say "Reusing existing dev checkout; fetching $branch…"
    if git -C "$dest" fetch --depth 1 origin "$branch" 2>/dev/null; then
      git -C "$dest" checkout -B "$branch" FETCH_HEAD 2>/dev/null \
        || git -C "$dest" checkout -f -B "$branch" FETCH_HEAD 2>/dev/null \
        || warn "Could not update to $branch; running whatever is checked out."
    else
      warn "Fetch failed (offline?). Running the existing checkout."
    fi
  else
    say "Cloning $url ($branch)…"
    git clone --depth 1 --branch "$branch" "$url" "$dest" || die "Clone failed — check the slug and branch name."
  fi
  [ -f "$dest/$LAUNCHER" ] || die "$dest has no $LAUNCHER — not a Marinara checkout?"

  # Isolated .env: dedicated data dir inside the throwaway checkout, distinct
  # port so it never collides with a running fork/main on 7860.
  {
    echo "DATA_DIR=$dest/packages/server/data"
    echo "PORT=$DEV_PORT"
    echo "MARINARA_MARI_ALLOW_UNSANDBOXED_SHELL=true"
  } > "$dest/.env"

  say "${c_grn}Fresh instance auto-seeds default data (Mari, preset, backgrounds, connection, game assets) on first boot.${c_rst}"
  say "${c_dim}View it at http://127.0.0.1:$DEV_PORT — clean up when done:  rm -rf $dest${c_rst}"
  cd "$dest" || die "cd $dest failed"
  # Guarantee the dev .env's DATA_DIR wins even if one is exported in the shell
  # (dotenv does not override an already-set process env var).
  unset DATA_DIR FILE_STORAGE_DIR
  exec "./$LAUNCHER" --skip-update
}

status() {
  say "${c_bold}Marinara channels${c_rst}"
  local pair name rest dir br h b
  for pair in "fork|$FORK_DIR|$FORK_BRANCH" "main|$MAIN_DIR|$MAIN_BRANCH"; do
    name="${pair%%|*}"; rest="${pair#*|}"; dir="${rest%%|*}"; br="${rest#*|}"
    if [ -d "$dir/.git" ]; then
      h="$(git -C "$dir" rev-parse --short HEAD 2>/dev/null || echo '?')"
      b="$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
      say "  ${c_grn}●${c_rst} $name  $dir  ${c_dim}[$b @ $h]${c_rst}"
    else
      say "  ${c_red}○${c_rst} $name  $dir  ${c_dim}(missing)${c_rst}"
    fi
  done
  local envfile="$FORK_DIR/.env" data=""
  [ -f "$envfile" ] && data="$(grep -E '^DATA_DIR=' "$envfile" 2>/dev/null | tail -1 | cut -d= -f2-)"
  say "  data  ${c_dim}${data:-<default per-clone — NOT shared!>}${c_rst}"
}

menu() {
  say "${c_bold}Which Marinara?${c_rst}"
  say "  ${c_grn}1${c_rst}) Custom fork      ${c_dim}($FORK_BRANCH)${c_rst}"
  say "  2) Mainline (stock)  ${c_dim}($MAIN_BRANCH)${c_rst}"
  say "  s) Status   q) Quit"
  printf 'Choice [1]: '
  local ans; read -r ans || ans=""
  case "${ans:-1}" in
    1|f|fork)   launch fork ;;
    2|m|main)   launch main ;;
    s|status)   status ;;
    q|quit)     exit 0 ;;
    *)          die "Unrecognized choice: $ans" ;;
  esac
}

case "${1:-}" in
  fork|f)                launch fork ;;
  main|m|mainline|stock) launch main ;;
  dev)                   dev "${2:-}" "${3:-}" ;;
  status|st)             status ;;
  ""|menu)               menu ;;
  -h|--help|help)
    say "Usage:"
    say "  marinara [fork|main]          launch a channel (no args → menu)"
    say "  marinara dev <owner/repo> <branch>  throwaway isolated checkout of any branch"
    say "  marinara status               show installed channels"
    ;;
  *)                     die "Unknown command: $1 (try: marinara fork | marinara main | marinara dev <slug> <branch> | marinara status)" ;;
esac
